<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rose Calculator - Currency & General Calculator</title>
    <meta name="description" content="Beautiful rose-themed calculator with currency note calculator and general calculator functionality">
    <style>
        :root {
            --rose-pink: #f8c8dc;
            --rose-red: #c93756;
            --rose-dark: #8a1538;
            --rose-light: #fde8ef;
            --rose-gold: #d4af37;
            --text-dark: #333;
            --text-light: #fff;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--rose-light);
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23f8c8dc' fill-opacity='0.2' fill-rule='evenodd'/%3E%3C/svg%3E");
            color: var(--text-dark);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            padding: 20px;
            background: linear-gradient(135deg, var(--rose-pink), var(--rose-red));
            border-radius: 15px;
            box-shadow: var(--shadow);
            color: var(--text-light);
            position: relative;
            overflow: hidden;
        }

        header::before, header::after {
            content: "❀";
            position: absolute;
            font-size: 2rem;
            color: var(--rose-light);
            opacity: 0.7;
        }

        header::before {
            top: 10px;
            left: 20px;
        }

        header::after {
            bottom: 10px;
            right: 20px;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .tagline {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr;
            gap: 30px;
        }

        @media (min-width: 768px) {
            .main-content {
                grid-template-columns: 1fr 1fr;
            }
        }

        .calculator-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: var(--shadow);
            border: 2px solid var(--rose-pink);
            position: relative;
        }

        .calculator-section::before {
            content: "";
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            border-radius: 17px;
            background: linear-gradient(45deg, var(--rose-pink), var(--rose-red), var(--rose-gold), var(--rose-pink));
            z-index: -1;
            opacity: 0.7;
        }

        h2 {
            color: var(--rose-dark);
            margin-bottom: 20px;
            text-align: center;
            font-size: 1.8rem;
            border-bottom: 2px dashed var(--rose-pink);
            padding-bottom: 10px;
        }

        .currency-calculator {
            display: flex;
            flex-direction: column;
        }

        .denomination-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
            background-color: var(--rose-light);
            transition: all 0.3s ease;
        }

        .denomination-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .denomination-label {
            font-weight: bold;
            color: var(--rose-dark);
            min-width: 80px;
        }

        .denomination-input {
            width: 100px;
            padding: 8px;
            border: 1px solid var(--rose-pink);
            border-radius: 5px;
            text-align: center;
            font-size: 1rem;
        }

        .denomination-total {
            font-weight: bold;
            min-width: 100px;
            text-align: right;
            color: var(--rose-dark);
        }

        .total-section {
            margin-top: 20px;
            padding: 15px;
            background: linear-gradient(135deg, var(--rose-pink), var(--rose-light));
            border-radius: 10px;
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--rose-dark);
        }

        .button-group {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .btn {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-save {
            background-color: var(--rose-red);
            color: white;
        }

        .btn-reset {
            background-color: var(--rose-gold);
            color: var(--text-dark);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .general-calculator {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .calc-display {
            grid-column: 1 / span 4;
            height: 70px;
            background-color: #f5f5f5;
            border: 1px solid var(--rose-pink);
            border-radius: 8px;
            margin-bottom: 15px;
            padding: 10px;
            font-size: 2rem;
            text-align: right;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            overflow: hidden;
        }

        .calc-btn {
            height: 60px;
            font-size: 1.2rem;
            border: none;
            border-radius: 8px;
            background-color: white;
            border: 1px solid var(--rose-pink);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .calc-btn:hover {
            background-color: var(--rose-light);
        }

        .calc-btn.operator {
            background-color: var(--rose-pink);
            color: white;
        }

        .calc-btn.equals {
            background-color: var(--rose-red);
            color: white;
        }

        .calc-btn.clear {
            background-color: var(--rose-gold);
            color: var(--text-dark);
        }

        .ad-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin: 40px 0;
        }

        .ad-space {
            background: linear-gradient(135deg, var(--rose-pink), var(--rose-light));
            border: 2px dashed var(--rose-red);
            border-radius: 10px;
            height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--rose-dark);
            font-weight: bold;
            text-align: center;
            padding: 10px;
        }

        footer {
            text-align: center;
            margin-top: 40px;
            padding: 20px;
            color: var(--rose-dark);
            font-size: 0.9rem;
            border-top: 1px solid var(--rose-pink);
        }

        .rose-icon {
            color: var(--rose-red);
            margin: 0 5px;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2rem;
            }
            
            .denomination-row {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .denomination-input {
                width: 100%;
                margin: 10px 0;
            }
            
            .denomination-total {
                text-align: left;
                width: 100%;
            }
            
            .general-calculator {
                grid-template-columns: repeat(4, 1fr);
            }
            
            .calc-btn {
                height: 50px;
                font-size: 1rem;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 10px;
            }
            
            .calculator-section {
                padding: 15px;
            }
            
            .general-calculator {
                grid-template-columns: repeat(4, 1fr);
                gap: 5px;
            }
            
            .calc-btn {
                height: 45px;
                font-size: 0.9rem;
            }
            
            .ad-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Rose Calculator <span class="rose-icon">🌹</span></h1>
            <p class="tagline">Elegant calculations with a floral touch</p>
        </header>

        <div class="ad-container">

            </section>

            <section class="calculator-section general-calculator">
                <h2>General Calculator</h2>
                <div class="calc-display" id="calc-display">0</div>
                <button class="calc-btn clear" data-action="clear">C</button>
                <button class="calc-btn clear" data-action="clear-all">AC</button>
                <button class="calc-btn operator" data-action="percent">%</button>
                <button class="calc-btn operator" data-action="divide">÷</button>
                <button class="calc-btn" data-number="7">7</button>
